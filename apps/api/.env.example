# Comma-separated origins. Use explicit origins in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
# Use PostgreSQL for local migrations and deployment. SQLite is used by isolated tests.
DATABASE_URL=postgresql+psycopg://arena:arena_local_only@localhost:5432/arena
DATABASE_ECHO=false

# Optional Gemini integration. Empty key keeps the deterministic fallback active.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=12
LLM_MAX_CONCURRENCY=6

# Request and environment settings.
APP_ENV=development
TRUSTED_HOSTS=localhost,127.0.0.1,testserver,api
TRUST_PROXY_HEADERS=false
MAX_REQUEST_BODY_BYTES=65536
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT=180
RATE_LIMIT_EXPENSIVE=30
RATE_LIMIT_AUTH=12
AUTH_SESSION_DAYS=30
SESSION_COOKIE_SECURE=false
