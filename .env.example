# Local development defaults. Do not commit a populated .env file.
POSTGRES_USER=arena
POSTGRES_PASSWORD=arena_local_only
POSTGRES_DB=arena
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://arena:arena_local_only@localhost:5432/arena

# Application ports and browser-facing API location.
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=

# Optional Gemini integration. Keep the key empty in the repository.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_TIMEOUT_SECONDS=25
LLM_TIMEOUT_SECONDS=22
LLM_MAX_CONCURRENCY=6

# Request limits and environment settings.
APP_ENV=development
TRUSTED_HOSTS=localhost,127.0.0.1,testserver,api
TRUST_PROXY_HEADERS=false
MAX_REQUEST_BODY_BYTES=65536
MAX_VOICE_REQUEST_BODY_BYTES=7200000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT=180
RATE_LIMIT_EXPENSIVE=30
RATE_LIMIT_AUTH=12
AUTH_SESSION_DAYS=30
# Enable only when the application is served over HTTPS.
SESSION_COOKIE_SECURE=false
LOG_LEVEL=INFO

# Public address used by the reverse proxy.
SITE_ADDRESS=http://localhost
SITE_HOST=localhost
